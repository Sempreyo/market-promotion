doctype html

block vars
include ../mixins/mixins

html(lang='ru')
	head
		meta(charset='UTF-8')
		meta(name='viewport', content='width=device-width, initial-scale=1.0')
		meta(name='description', content='Продвижение на CNewsMarket: ТОП-3 в поиске, карточка компании и предложение месяца для ИТ-поставщиков.')
		meta(name='theme-color', content='#ff4400')

		meta(property='og:type', content='website')
		meta(property='og:site_name', content='CNewsMarket')
		meta(property='og:title', content='Продвижение на CNewsMarket')
		meta(property='og:description', content='ТОП-3 в поиске, карточка компании и предложение месяца для ИТ-поставщиков.')
		meta(property='og:url', content='https://market.cnews.ru/')

		script.
			document.documentElement.classList.add('js');

		link(href='css/main.min.css', rel='stylesheet', type='text/css')
		title= `${page.title}`

	body
		block header
			include ../blocks/header

		main#main.main
			block main

		block footer
			include ../blocks/footer

		button.button-up(type='button', aria-label='Наверх')
			+icon('arrow-up')

		block modals

		script(src="js/main.min.js" defer)

		block scripts